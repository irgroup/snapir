# Copy to .env and fill in. run.sh loads it automatically.

# Any OpenAI-compatible endpoint (here: OpenRouter). 
# Models named gemini* use Google GenAI instead (pip install "snapir[gemini]").
SNAPIR_LLM_MODEL=qwen/qwen3.5-122b-a10b
SNAPIR_LLM_BASE_URL=https://openrouter.ai/api/v1
SNAPIR_LLM_API_KEY=
SNAPIR_LLM_CONCURRENCY=4

SERPAPI_API_KEY=
